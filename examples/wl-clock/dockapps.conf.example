# Entries for ~/.config/wmaker-wl/dockapps.conf that use wl-clock.
# (The full format is in wmaker-wl's docs/DOCKAPPS.md and src/share/dockapps.conf.)
#
# The entry NAME is what ties the entry to the window: wl-clock sets its app_id
# to "dockapp:<name>" (--name, default "clock"), and wmaker-wl puts a 64x64
# window with that app_id into the Dock tile of the entry of the same name.
# So the name in [brackets] and wl-clock's --name must be the same.
#
# wl-clock has to be in $PATH (zig build --prefix ~/.local install), or give
# the full path in `command =`.

# The local time, in the first tile below the Dock's logo.
[clock]
command = wl-clock
position = 0,1
autolaunch = yes

# A second clock for another time zone. The label replaces the month name.
[tokyo]
command = wl-clock --name tokyo --tz Asia/Tokyo --label tokyo
position = 0,2
autolaunch = yes

# 12-hour clock without the seconds bar (redraws once a minute).
[clock12]
command = wl-clock --name clock12 --12h --no-seconds
position = 0,3
autolaunch = no

# Not in the Dock but in the Clip, on workspace 1 only:
#
# [clock-ws1]
# command = wl-clock --name clock-ws1
# place = clip
# workspace = 1
#
# (A DockApp window is only moved into a tile of the DOCK; a Clip tile just
# launches or focuses it.)
