#!/bin/sh
# wmaker-wl-session: start a WaylandMaker session (login manager entry point).
#
# Started through wmaker-wl.desktop, or by hand from a TTY. In order:
#   1. sets the XDG_* session variables
#   2. logs to $XDG_STATE_HOME/wmaker-wl/session.log when there is no terminal
#   3. reads ~/.config/wmaker-wl/env (optional, plain sh), e.g.
#          export XKB_DEFAULT_LAYOUT=de
#   4. makes sure XDG_RUNTIME_DIR exists
#   5. runs the compositor: as the systemd user unit wmaker-wl.service when it
#      is installed and a user manager is running (then graphical-session.target
#      works, and the compositor log is in `journalctl --user -u wmaker-wl`),
#      otherwise directly, under dbus-run-session if there is no session bus.
#
# Overrides: WMAKER_WL=/path/to/wmaker-wl   WMAKER_NO_SYSTEMD=1

name=wmaker-wl-session

die() {
    echo "$name: $*" >&2
    exit 1
}

# The compositor: next to this script, else in PATH.
wm=${WMAKER_WL:-}
if [ -z "$wm" ]; then
    case $0 in
    */*) bindir=$(cd "$(dirname "$0")" && pwd) ;;
    *) bindir= ;;
    esac
    if [ -n "$bindir" ] && [ -x "$bindir/wmaker-wl" ]; then
        wm=$bindir/wmaker-wl
    else
        wm=wmaker-wl
    fi
fi

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=wmaker-wl
export XDG_CURRENT_DESKTOP=wmaker-wl

# No terminal (login manager): keep the output, one old log is kept.
state=${XDG_STATE_HOME:-${HOME:-}/.local/state}/wmaker-wl
if [ ! -t 2 ] && [ -n "${HOME:-}" ] && mkdir -p "$state" 2>/dev/null; then
    log=$state/session.log
    if [ -f "$log" ] && [ "$(wc -c <"$log")" -gt 1048576 ]; then
        mv -f "$log" "$log.old"
    fi
    exec >>"$log" 2>&1
    echo "== $(date '+%F %T') $name (pid $$)"
fi

cfg=${XDG_CONFIG_HOME:-${HOME:-}/.config}/wmaker-wl
if [ -r "$cfg/env" ]; then
    # A syntax error would end this shell, and with it the login.
    if sh -n "$cfg/env" 2>/dev/null; then
        # shellcheck disable=SC1091
        . "$cfg/env"
    else
        echo "$name: $cfg/env has a syntax error, ignored" >&2
    fi
fi

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    rd=/run/user/$(id -u)
    if [ -d "$rd" ] && [ -w "$rd" ]; then
        XDG_RUNTIME_DIR=$rd
        export XDG_RUNTIME_DIR
    else
        die "XDG_RUNTIME_DIR is not set (log in through logind/elogind, or set it in $cfg/env)"
    fi
fi

command -v "$wm" >/dev/null 2>&1 || die "cannot find the compositor ($wm); set WMAKER_WL"

use_systemd() {
    [ -z "${WMAKER_NO_SYSTEMD:-}" ] && [ -z "${WMAKER_WL:-}" ] || return 1
    command -v systemctl >/dev/null 2>&1 || return 1
    systemctl --user cat wmaker-wl.service >/dev/null 2>&1
}

if use_systemd; then
    if systemctl --user is-active --quiet wmaker-wl.service; then
        die "wmaker-wl.service is already running"
    fi
    # A failed earlier session must not keep graphical-session.target down.
    systemctl --user reset-failed 2>/dev/null
    # The unit gets the environment of this script.
    systemctl --user import-environment
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --all
    fi
    echo "$name: starting wmaker-wl.service"
    systemctl --user --wait start wmaker-wl.service
    rc=$?
    # Stop everything that was bound to graphical-session.target.
    systemctl --user start --job-mode=replace-irreversibly wmaker-wl-shutdown.target
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY NOTIFY_SOCKET \
        XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP
    exit "$rc"
fi

echo "$name: starting $wm"
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$wm" "$@"
fi
exec "$wm" "$@"
